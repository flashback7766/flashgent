# flashgent environment
# Copy to ~/.flashgent/.env (or project root) and fill in as needed.

# Optional API key if your LM Studio instance requires one.
LMSTUDIO_API_KEY=

# Optional: override the default endpoint (also settable in Settings UI).
LMSTUDIO_BASE_URL=http://localhost:1234/v1

# Verbose logging: set to 1 to enable DEBUG level + DevTools.
DEBUG=
